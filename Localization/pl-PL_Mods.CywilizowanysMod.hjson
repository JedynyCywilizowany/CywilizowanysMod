Items: {
	CheatCharm: {
		DisplayName: Obrączka oszustwa
		Tooltip: Zaprojektowana do pomocy w testowaniu modów bez przeszkód ze strony nieznośnych rzeczy, takich jak śmiertelność
	}

	DevSet_Cywil_Helmet: {
		DisplayName: Hełm Jedynego Cywilizowanego
		// Tooltip: ""
	}

	DevSet_Cywil_Chestpiece: {
		DisplayName: Napierśnik Jedynego Cywilizowanego
		// Tooltip: ""
	}

	DevSet_Cywil_Boots: {
		DisplayName: Buty Jedynego Cywilizowanego
		// Tooltip: ""
	}

	DevSet_Cywil_Wings: {
		DisplayName: Płaszcz Jedynego Cywilizowanego
		// Tooltip: ""
	}

	Autoseller: {
		DisplayName: Stacja do autosprzedaży
		Tooltip: Automatycznie sprzedaje wybrane przedmioty do najszczęśliwszego kupca w zasięgu, ale po zredukowanej cenie
	}

	AutosellerBag: {
		DisplayName: Torba do autosprzedaży
		Tooltip:
			'''
			Pozwala na zdalną autosprzedaż, ale ma ograniczoną pojemność
			Opróżnia się gdy normalna autosprzedaż jest możliwa
			'''
	}
}

Buffs: {
	Autoselling: {
		DisplayName: Autosprzedaż
		Description: Wybrane przedmioty będą automatycznie sprzedawane, jeśli to możliwe
	}
}

Configs: {
	CywilsConfig_Client: {
		DisplayName: Ustawienia klienta

		TextureLoadOptimization: {
			Label: Optymalizacja ładowania tekstur
			Tooltip:
				'''
				Jeśli włączone, większość tekstur będzie ładowane tylko gdy są używane
				Może być niekompatybilne z niektórymi modami
				'''
		}

		AutosellWhenBagIsFull: {
			Label: Autosprzedaż przy pełnej torbie
			Tooltip: Czy torba do autosprzedaży powinna wciąż zbierać przedmioty jak jest pełna, mimo że nie zapewni więcej monet
		}
	}

	CywilsConfig_World: {
		DisplayName: Ustawienia świata

		ShowDayCounter: {
			Label: Licznik dni
			Tooltip:
				'''
				Komunikuje w chatcie ile dni minęło na tym świecie, przy wchodzeniu i każdego ranka
				Jeśli ta opcja jest wyłączona, dni wciąż są liczone, ale nie wyświetlane
				'''
		}

		Headers.WorldItems: Przedmioty w świecie

		ThresholdForItemMerging: {
			Label: Próg do łączenia przedmiotów
			Tooltip: Część miesjc na przedmioty w świecie która musi być zapełniona, żeby przedmioty zaczęły się łączyć
		}

		UnstuckItems: {
			Label: Wydostawanie przedmiotów
			Tooltip: Przedmioty, które utknęły w ziemii, będą powoli przemieszczać się w kierunku najbliższej pustej przestreni
		}

		ItemsDespawnTime: {
			Label: Czas znikania przedmiotów
			Tooltip:
				'''
				Czas, w minutach, po którym upuszczone przedmioty znikają
				Skrócony o połowę dla pospolitych przedmiotów
				Jeśli ustawione na 0, nie znikają
				'''
		}

		PickupsDespawnTime: {
			Label: Czas znikania jednorazówek
			Tooltip:
				'''
				Czas, w minutach, po którym jednorazówki (np. leczące serca) znikają
				Jeśli ustawione na 0, nie znikają
				'''
		}
	}
}

Keybinds.ToggleAutosellForItem.DisplayName: Przełącz autosprzedaż dla przedmiotu

Tooltips: {
	ItemAutosold: Ten przedmiot jest automatycznie sprzedawany

	AutosellingEnabled: {
		True: Autosprzedaż włączona, kliknij prawym aby wyłączyć
		False: Autosprzedaż wyłączona, kliknij prawym aby włączyć
	}
}

UI: {
	AutosoldItemList: Lista przedmiotów na autosprzedaż
	DropAutosold: Wyrzuć przedmioty na autosprzedaż z ekwipunku
}

Messages.DayCounter: Dzień {0}
